root = true

[*]
charset = utf-8
insert_final_newline = true

[*.{c,cc,cpp,h,hpp,txt,cmake,yml,yaml,json,sh}]
trim_trailing_whitespace = true

[*.{c,cc,cpp,h,hpp}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2
